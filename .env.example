# Copy this file to .env and fill it in. The app reads .env on start, so you
# never have to set variables in the shell. Real environment variables (what
# Railway sets) always win over this file.
#
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (Mac / Linux)

# ---------------------------------------------------------------- basics
PORT=4700
# The address people reach the site on. Gateways call back to it, so on a
# server this MUST be the real public URL, not localhost.
PUBLIC_URL=http://localhost:4700

# Signs the forms. Any long random string. Changing it logs out open forms.
CSRF_SECRET=change-me-to-something-long-and-random

# ------------------------------------------------------------- sign in
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# The redirect URI must match EXACTLY, including the path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4700/auth/google/callback

# These Google accounts become admins the moment they sign in. Comma separated.
ADMIN_EMAILS=

# Lets you sign in without Google while building, from this machine only.
# Set it to 1 locally, and never on a server.
ALLOW_DEV_LOGIN=1

# ------------------------------------------------------------- payments
# EPS - bKash, Nagad, Rocket, cards. Leave blank until you have an account.
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_SANDBOX=1

# Cryptomus - crypto. The callback URL must be reachable from the internet,
# so this cannot be tested on localhost.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=

# ------------------------------------------------------------- storage
# Where the database and uploaded proofs live. On Railway point this at a
# mounted volume, or every deploy wipes the site.
# DATA_DIR=/data

# ------------------------------------------------------------- email
# Outgoing mail. Everything here can also be set from Admin > Settings, but
# the environment wins - a password belongs in the environment, not the
# database. Leave blank and the site simply queues mail without sending it.
#
# Gmail:  smtp.gmail.com / 587, and an App Password (not your normal one),
#         which needs 2-step verification switched on first.
# Brevo:  smtp-relay.brevo.com / 587, free for a few hundred a day.
#
# Port 587 upgrades to TLS with STARTTLS; port 465 is TLS from the start.
# Both are encrypted - sending in the clear is refused either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Who the mail comes from. Must be an address your SMTP account may send as,
# or the server will reject it.
MAIL_FROM=
MAIL_FROM_NAME=Remote Work BD
